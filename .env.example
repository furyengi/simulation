# Copy to `.env` (git-ignored) and fill in only what you need.
# Nothing here is required for the core simulation to run.
# NEVER commit real values. CI does not need any secrets.

# --- Server -----------------------------------------------------------
SIM_SERVER_HOST=127.0.0.1
SIM_SERVER_PORT=8787
# Directory for cached responses from external providers (CelesTrak, NOAA, OpenSky, IERS).
SIM_CACHE_DIR=.simulation-cache
# Set to 1 to forbid all outbound network requests (uses committed fixtures / cache only).
SIM_OFFLINE=0

# --- Optional: OpenSky Network (aircraft layer) ------------------------
# The aircraft layer works anonymously with a very small daily quota.
# For a higher quota create an API client at https://opensky-network.org (OAuth2 client credentials).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Web (build-time; exposed to the browser, so never put secrets here) ---
# Optional Cesium ion token. Not required: the default globe uses bundled offline imagery.
VITE_CESIUM_ION_TOKEN=
VITE_API_BASE_URL=http://127.0.0.1:8787
