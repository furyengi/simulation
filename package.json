{
  "name": "simulation",
  "version": "0.1.0",
  "private": true,
  "description": "Scientifically defensible Earth and space simulation environment.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "validation"
  ],
  "scripts": {
    "dev": "npm-run-all2 -p dev:server dev:web",
    "dev:server": "npm run dev --workspace @simulation/server",
    "dev:web": "npm run dev --workspace @simulation/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vitest run --project validation --passWithNoTests",
    "bench": "npm run bench --workspace @simulation/environment",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.5.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
